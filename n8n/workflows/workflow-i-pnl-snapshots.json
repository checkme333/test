{
  "name": "PNL Snapshots (Every 30 Minutes)",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "const models = [\"chatgpt\", \"grok\", \"gemini\", \"deepseek\"];\n\nreturn models.map(model => ({\n  json: {\n    model: model\n  }\n}));"
      },
      "id": "set-models",
      "name": "Set Models",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "=http://trading-core:8000/models/{{ $json.model }}/account",
        "method": "GET",
        "options": {}
      },
      "id": "get-account",
      "name": "Get Account Balance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "const model = $input.item.json.model;\nconst account = $input.item.json;\n\nif (!account || !account.current_balance) {\n  return [{\n    json: {\n      model: model,\n      pnl: 0\n    }\n  }];\n}\n\nconst initialBalance = 500;\nconst currentBalance = account.current_balance || 0;\nconst unrealizedPnl = account.unrealized_pnl || 0;\nconst totalEquity = currentBalance + unrealizedPnl;\nconst pnl = totalEquity - initialBalance;\n\nreturn [{\n  json: {\n    model: model,\n    pnl: pnl\n  }\n}];"
      },
      "id": "extract-pnl",
      "name": "Extract PNL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "url": "=http://trading-core:8000/pnl/snapshot?model={{ $json.model }}&pnl={{ $json.pnl }}",
        "method": "POST",
        "options": {}
      },
      "id": "save-snapshot",
      "name": "Save PNL Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 300]
    }
  ],
  "connections": {
    "Every 30 Minutes": {
      "main": [
        [
          {
            "node": "Set Models",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Models": {
      "main": [
        [
          {
            "node": "Get Account Balance",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Account Balance": {
      "main": [
        [
          {
            "node": "Extract PNL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract PNL": {
      "main": [
        [
          {
            "node": "Save PNL Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
