      "position": [450, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-models",
      "name": "Split Models",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "const models = $input.item.json.models;\nconst symbols = $input.item.json.symbols;\nconst modelIndex = $index;\nconst model = models[modelIndex];\nconst symbol = symbols[Math.floor(Math.random() * symbols.length)];\n\nreturn {\n  model: model,\n  symbol: symbol\n};"
      },
      "id": "select-symbol",
      "name": "Select Random Symbol",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "url": "=http://trading-core:8000/llm/execute-decision?model={{ $json.model }}&symbol={{ $json.symbol }}",
        "method": "POST",
        "options": {}
      },
      "id": "execute-decision",
      "name": "Execute AI Decision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 300]
    },
    {
      "parameters": {},
