grid.jimmysan.com {
    root * /srv/frontend
    file_server
    try_files {path} /index.html
    
    log {
        output file /var/log/caddy/grid.log
    }
}

api.jimmysan.com {
    reverse_proxy trading-core:8000
    
    log {
        output file /var/log/caddy/api.log
    }
}

hook.jimmysan.com {
    reverse_proxy n8n:5678
    
    log {
        output file /var/log/caddy/hook.log
    }
}
